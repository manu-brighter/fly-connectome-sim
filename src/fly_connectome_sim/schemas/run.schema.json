      "properties": {
        "start_ms": {"type": "number"},
        "end_ms": {"type": "number"}
      }
    },
    "qualification_benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulated_seconds", "event_count", "checkpoint_bytes", "peak_event_buffer_bytes"],
      "properties": {
        "simulated_seconds": {"type": "number", "minimum": 0},
        "event_count": {"type": "integer", "minimum": 0},
        "checkpoint_bytes": {"type": "integer", "minimum": 0},
        "peak_event_buffer_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "motor_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_version", "signed_difference_hz", "evidence_strength", "action"],
      "properties": {
        "adapter_version": {"const": "lateral-motor-adapter/v1"},
        "signed_difference_hz": {"type": "number"},
        "evidence_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "action": {"type": "string", "enum": ["inspect_left", "inspect_right", "defer"]}
      }
    },
    "motor_readout": {
      "type": "object", "additionalProperties": false,
      "required": ["interpretation", "action_threshold_hz", "decision"],
      "properties": {
        "interpretation": {"const": "engineered_unvalidated_motor_readout"},
        "action_threshold_hz": {"type": "number", "minimum": 0},
        "decision": {"$ref": "#/$defs/motor_decision"}
      }
    },
    "event": {
      "type": "object",
      "required": ["sequence", "type", "branch_id", "sim_ms", "run_metadata_sha256", "previous_scientific_sha256", "scientific_sha256"],
      "dependentRequired": {
        "parent_checkpoint_name": ["parent_checkpoint_sequence"],
        "parent_checkpoint_sequence": ["parent_checkpoint_name"]},
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "type": {"type": "string", "minLength": 1},
        "branch_id": {"type": "string", "minLength": 1},
        "sim_ms": {"type": "number", "minimum": 0},
        "run_metadata_sha256": {"$ref": "#/$defs/digest"},
        "previous_scientific_sha256": {"$ref": "#/$defs/digest"},
        "scientific_sha256": {"$ref": "#/$defs/digest"},
        "parent_branch_id": {"type": "string", "minLength": 1},
        "parent_checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "parent_state_anchor_sha256": {"$ref": "#/$defs/digest"},
        "parent_checkpoint_name": {"$ref": "#/$defs/source_occurrence/properties/checkpoint_name"},
        "parent_checkpoint_sequence": {"$ref": "#/$defs/tick"},
        "checkpoint_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.npz$"},
        "checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "checkpoint_size": {"type": "integer", "minimum": 0},
        "motor_readout": {"$ref": "#/$defs/motor_readout"}
      },
      "additionalProperties": true,
      "not": {"required": ["parent_checkpoint_sha256", "parent_state_anchor_sha256"]},
      "allOf": [{"if": {"properties": {"type": {"const": "qualification_grid_binding"}}, "required": ["type"]}, "then": {"$ref": "#/$defs/qualification_grid_binding"}}, {
        "if": {"properties": {"type": {}}, "required": ["parent_state_anchor_sha256"]},
        "then": {"not": {"anyOf": [
            {"required": ["parent_checkpoint_sha256"]}, {"required": ["parent_checkpoint_name"]},
            {"required": ["parent_checkpoint_sequence"]}]}}
      }, {
        "if": {"properties": {"type": {"const": "state_anchor"}}, "required": ["type"]},
        "then": {"$ref": "#/$defs/state_anchor_event"}
      }, {
        "if": {"properties": {"type": {"const": "qualification_result"}}, "required": ["type"]},
        "then": {
          "required": ["status", "family", "seeds", "selected_configuration", "selected_window", "selected_retention_ms", "observed_effect_sign", "benchmark", "compute_seconds"],
          "properties": {
            "status": {"enum": ["supported", "unsupported"]},
            "family": {"type": "string", "minLength": 1},
            "seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
            "selected_configuration": {"oneOf": [{"$ref": "#/$defs/qualification_configuration"}, {"type": "null"}]},
            "selected_window": {"oneOf": [{"$ref": "#/$defs/qualification_window"}, {"type": "null"}]},
            "selected_retention_ms": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
            "observed_effect_sign": {"enum": [-1, 1, null]},
            "benchmark": {"$ref": "#/$defs/qualification_benchmark"},
            "compute_seconds": {"type": "number", "minimum": 0}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "supported"}}, "required": ["status"]},
              "then": {"properties": {
                "selected_configuration": {"$ref": "#/$defs/qualification_configuration"},
                "selected_window": {"$ref": "#/$defs/qualification_window"},
                "selected_retention_ms": {"type": "number", "exclusiveMinimum": 0},
                "observed_effect_sign": {"enum": [-1, 1]}
              }}
            },
            {
              "if": {"properties": {"status": {"const": "unsupported"}}, "required": ["status"]},
              "then": {"properties": {
                "selected_configuration": {"type": "null"},
                "selected_window": {"type": "null"},
                "selected_retention_ms": {"type": "null"},
                "observed_effect_sign": {"type": "null"}
              }}
            }
          ]
        }
      }, {
        "if": {"properties": {"type": {"const": "assay_result"}}, "required": ["type"]},
        "then": {
          "required": ["result_version", "analysis_version", "frozen_config_sha256", "status", "reasons", "report", "report_sha256", "evidence_event_count", "evidence_final_scientific_sha256"],
          "properties": {
            "result_version": {"const": "mbon11-assay-result/v1"},
            "analysis_version": {"const": "mbon11-causal-analysis/v1"},
            "frozen_config_sha256": {"$ref": "#/$defs/digest"},
            "status": {"enum": ["supported", "unsupported", "inconclusive"]},
            "reasons": {"$ref": "#/$defs/assay_reasons"},
            "report": {"$ref": "#/$defs/assay_report"},
            "report_sha256": {"$ref": "#/$defs/digest"},
            "evidence_event_count": {"type": "integer", "minimum": 0},
            "evidence_final_scientific_sha256": {"$ref": "#/$defs/digest"}
          },
          "allOf": [{
            "if": {"properties": {"status": {"const": "supported"}}, "required": ["status"]},
            "then": {"properties": {"reasons": {"maxItems": 0}}},
            "else": {"properties": {"reasons": {"minItems": 1}}}
          }]
        }
      }, {
        "if": {"required": ["motor_readout"]},
        "then": {
          "required": ["telemetry"],
          "properties": {
            "type": {"enum": ["observation", "observe"]},
            "telemetry": {
              "type": "object", "required": ["engine_identity", "rates_hz", "sim_ms"],
              "properties": {
                "engine_identity": {"type": "object", "minProperties": 1},
                "sim_ms": {"type": "number", "minimum": 0},
                "rates_hz": {
                  "type": "object", "required": ["motor_left", "motor_right"],
                  "properties": {
                    "motor_left": {"type": "number", "minimum": 0},
                    "motor_right": {"type": "number", "minimum": 0}
                  }
                }
              }
            }
          }
        }
      }]
    },
    "state_anchor_event": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_version", "anchor_id", "state_anchor_sha256", "origin_branch_id", "sim_tick", "complete_state_sha256", "durable_ancestor_checkpoint_sha256", "replay_recipe_sha256", "source_identity_sha256", "run_metadata_sha256", "source_occurrence", "scientific_prefix", "recipe", "sequence", "type", "branch_id", "sim_ms", "previous_scientific_sha256", "scientific_sha256"],
      "properties": {
        "anchor_version": {"$ref": "#/$defs/state_anchor/properties/anchor_version"}, "anchor_id": {"$ref": "#/$defs/identifier"},
        "state_anchor_sha256": {"$ref": "#/$defs/digest"}, "origin_branch_id": {"$ref": "#/$defs/identifier"},
        "sim_tick": {"$ref": "#/$defs/tick"}, "complete_state_sha256": {"$ref": "#/$defs/digest"},
        "durable_ancestor_checkpoint_sha256": {"$ref": "#/$defs/digest"}, "replay_recipe_sha256": {"$ref": "#/$defs/digest"},
        "source_identity_sha256": {"$ref": "#/$defs/digest"}, "run_metadata_sha256": {"$ref": "#/$defs/digest"},
        "source_occurrence": {"$ref": "#/$defs/source_occurrence"}, "scientific_prefix": {"$ref": "#/$defs/scientific_prefix"},
        "recipe": {"$ref": "#/$defs/black_retention_recipe"}, "sequence": {"$ref": "#/$defs/tick"},
        "type": {"const": "state_anchor"}, "branch_id": {"$ref": "#/$defs/identifier"},
        "sim_ms": {"type": "number", "minimum": 0}, "previous_scientific_sha256": {"$ref": "#/$defs/digest"},
        "scientific_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "description": "events.jsonl contains compact sorted-key UTF-8 LF JSON objects in append order. First previous_scientific_sha256 is 64 ASCII zeroes. Root events omit ancestry. Each new branch references exactly one prior durable checkpoint occurrence or state-anchor occurrence and its origin branch at the exact parent clock. Legacy checkpoint-only references must be unambiguous; replay forks also require the exact checkpoint name/sequence. Later events may omit or consistently repeat established ancestry. Checkpoint inventory records event sequence and, when required for replay, authoritative integer sim_tick. State-anchor inventory indexes the strict canonical envelope by occurrence digest and records its exact event_sequence, separately from durable NPZ inventory. Recorder and scanner rebuild each anchor recipe from the actual completed preceding scientific prefix, metadata.engine_identity and metadata.black_input. Equality, ordering, digest recomputation, integer-clock agreement and cross-event ancestry/inventory constraints are verifier-enforced. Qualification and confirmation runs retain their single terminal result and metadata/evidence-prefix bindings; the independent analyzer retains scientific classification authority. Scientific projection removes only compute_seconds and kernel_seconds recursively and the event's own scientific_sha256. Raw event/prefix/seal bytes remain integrity-only and never enter recipe/envelope identity. No persisted attested flags exist: ordinary verification provides no replay attestation; formal verification restores/replays every occurrence in an isolated compatible engine and rechecks the entire artifact or fixed prefix before issuing immutable attestation. Checkpoints live under checkpoints/ with safe .npz basenames. Exact packaged-schema digest matching is required; older artifacts are not silently migrated. The verifier is authoritative."
}
