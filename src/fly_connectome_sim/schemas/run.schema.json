{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fly-connectome-sim.local/schemas/run.schema.json",
  "title": "Fly connectome sealed run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "schema_version", "schema_sha256", "run_kind", "root_branch_id", "metadata", "run_metadata_sha256", "event_count", "final_scientific_sha256", "events_sha256", "checkpoints", "state_anchors"],
  "properties": {
    "format_version": {"const": "run-artifact/v1"},
    "schema_version": {"const": "run-schema/v1"},
    "schema_sha256": {"$ref": "#/$defs/digest"},
    "run_kind": {"enum": ["pilot", "qualification", "confirmation"]},
    "root_branch_id": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "required": ["engine_identity", "protocol_version", "stimulus_version", "family", "seeds", "factors", "input_sha256"],
      "properties": {
        "engine_identity": {"type": "object", "minProperties": 1},
        "protocol_version": {"type": "string", "minLength": 1},
        "stimulus_version": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "factors": {"type": "object"},
        "input_sha256": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "black_input": {"$ref": "#/$defs/black_input"}
      },
      "additionalProperties": true
    },
    "run_metadata_sha256": {"$ref": "#/$defs/digest"},
    "event_count": {"type": "integer", "minimum": 0},
    "final_scientific_sha256": {"$ref": "#/$defs/digest"},
    "events_sha256": {"$ref": "#/$defs/digest"},
    "checkpoints": {
      "type": "object",
      "required": ["brain-before.npz", "brain-after.npz"],
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.npz$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size", "origin_branch_id", "sim_ms", "checkpoint_sequence"],
        "properties": {
          "sha256": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 0},
          "origin_branch_id": {"type": "string", "minLength": 1},
          "sim_ms": {"type": "number", "minimum": 0},
          "checkpoint_sequence": {"$ref": "#/$defs/tick"},
          "sim_tick": {"$ref": "#/$defs/tick"}
        }
      }
    },
    "state_anchors": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/digest"},
      "additionalProperties": {"$ref": "#/$defs/anchor_occurrence"}
    }
  },
  "allOf": [{
    "if": {"properties": {"run_kind": {"const": "confirmation"}}, "required": ["run_kind"]},
    "then": {"properties": {"metadata": {
      "required": ["frozen_config_sha256", "assay_contract"],
      "properties": {
        "frozen_config_sha256": {"$ref": "#/$defs/digest"},
        "assay_contract": {
          "type": "object",
          "required": ["analysis_version"],
          "properties": {"analysis_version": {"const": "mbon11-causal-analysis/v1"}}
        }
      }
    }}}
  }],
  "$defs": {
    "qualification_grid_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "stage", "condition", "stimulus", "retention_ms", "reason"],
      "properties": {
        "scope": {"enum": ["base", "retention"]},
        "stage": {"enum": ["pre", "pre_replay", "training", "base_validation", "retention_timing", "retention", "post", "measurement"]},
        "condition": {"enum": ["paired", "matched_reference", "frozen_plasticity", "paired_replay", null]},
        "stimulus": {"enum": ["A", "B", "C", null]},
        "retention_ms": {"type": ["integer", "null"], "enum": [10000, 20000, 30000, 60000, null]},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "base"}}},
          "then": {
            "properties": {"stage": {"enum": ["pre", "pre_replay", "training", "base_validation"]}, "retention_ms": {"type": "null"}},
            "if": {"properties": {"stage": {"const": "training"}}},
            "then": {"properties": {"condition": {"enum": ["paired", "matched_reference", "frozen_plasticity", "paired_replay"]}}},
            "else": {"properties": {"condition": {"type": "null"}}}
          },
          "else": {
            "properties": {
              "stage": {"enum": ["retention_timing", "retention", "post", "measurement"]},
              "retention_ms": {"type": "integer", "enum": [10000, 20000, 30000, 60000]}
            },
            "if": {"properties": {"stage": {"enum": ["retention", "post"]}}},
            "then": {"properties": {"condition": {"enum": ["paired", "frozen_plasticity", "matched_reference"]}}},
            "else": {"properties": {"condition": {"type": "null"}}}
          }
        }
      ]
    },
    "grid_retained_occurrences": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "paired": {"$ref": "#/$defs/source_occurrence"},
        "frozen_plasticity": {"$ref": "#/$defs/source_occurrence"},
        "matched_reference": {"$ref": "#/$defs/source_occurrence"}
      }
    },
    "grid_retention_sequences": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "paired": {"type": "array", "maxItems": 120, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
        "frozen_plasticity": {"type": "array", "maxItems": 120, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
        "matched_reference": {"type": "array", "maxItems": 120, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}}
      }
    },
    "grid_post_sequences": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "paired": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "A": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
            "B": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
            "C": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}}
          }
        },
        "frozen_plasticity": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "A": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
            "B": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}}
          }
        },
        "matched_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "A": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
            "B": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}}
          }
        }
      }
    },
    "qualification_grid_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_version",
        "grid_evidence_id",
        "grid_index",
        "seed",
        "paired_identity",
        "presentation_order",
        "baseline_occurrence",
        "training_occurrences",
        "retained_occurrences",
        "observation_sequences",
        "failures",
        "sequence",
        "type",
        "branch_id",
        "sim_ms",
        "run_metadata_sha256",
        "previous_scientific_sha256",
        "scientific_sha256"
      ],
      "properties": {
        "binding_version": {"const": "qualification-grid-binding/v1"},
        "grid_evidence_id": {"type": "string", "pattern": "^grid/(?:[0-9]|1[01])/(?:11|23)/[AB]/(?:AB|BA)$"},
        "grid_index": {"type": "integer", "minimum": 0, "maximum": 11},
        "seed": {"type": "integer", "enum": [11, 23]},
        "paired_identity": {"enum": ["A", "B"]},
        "presentation_order": {"enum": ["AB", "BA"]},
        "baseline_occurrence": {"$ref": "#/$defs/source_occurrence"},
        "training_occurrences": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "paired": {"$ref": "#/$defs/source_occurrence"},
            "matched_reference": {"$ref": "#/$defs/source_occurrence"},
            "frozen_plasticity": {"$ref": "#/$defs/source_occurrence"},
            "paired_replay": {"$ref": "#/$defs/source_occurrence"}
          }
        },
        "retained_occurrences": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "10000": {"$ref": "#/$defs/grid_retained_occurrences"},
            "20000": {"$ref": "#/$defs/grid_retained_occurrences"},
            "30000": {"$ref": "#/$defs/grid_retained_occurrences"},
            "60000": {"$ref": "#/$defs/grid_retained_occurrences"}
          }
        },
        "observation_sequences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre", "training", "retention", "post"],
          "properties": {
            "pre": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "A": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
                "B": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
                "C": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}}
              }
            },
            "pre_replay": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
            "training": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "paired": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
                "matched_reference": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
                "frozen_plasticity": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}},
                "paired_replay": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/tick"}}
              }
            },
            "retention": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "10000": {"$ref": "#/$defs/grid_retention_sequences"},
                "20000": {"$ref": "#/$defs/grid_retention_sequences"},
                "30000": {"$ref": "#/$defs/grid_retention_sequences"},
                "60000": {"$ref": "#/$defs/grid_retention_sequences"}
              }
            },
            "post": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "10000": {"$ref": "#/$defs/grid_post_sequences"},
                "20000": {"$ref": "#/$defs/grid_post_sequences"},
                "30000": {"$ref": "#/$defs/grid_post_sequences"},
                "60000": {"$ref": "#/$defs/grid_post_sequences"}
              }
            }
          }
        },
        "failures": {
          "oneOf": [
            {"type": "array", "maxItems": 0},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"allOf": [{"$ref": "#/$defs/qualification_grid_failure"}, {"properties": {"scope": {"const": "base"}}}]}
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {"allOf": [{"$ref": "#/$defs/qualification_grid_failure"}, {"properties": {"scope": {"const": "retention"}}}]}
            }
          ]
        },
        "sequence": {"type": "integer", "minimum": 0},
        "type": {"const": "qualification_grid_binding"},
        "branch_id": {"type": "string", "minLength": 1},
        "sim_ms": {"type": "number", "minimum": 0},
        "run_metadata_sha256": {"$ref": "#/$defs/digest"},
        "previous_scientific_sha256": {"$ref": "#/$defs/digest"},
        "scientific_sha256": {"$ref": "#/$defs/digest"},
        "parent_branch_id": {"type": "string", "minLength": 1},
        "parent_checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "parent_checkpoint_name": {"$ref": "#/$defs/source_occurrence/properties/checkpoint_name"},
        "parent_checkpoint_sequence": {"$ref": "#/$defs/tick"}
      },
      "allOf": [
        {
          "if": {"properties": {"paired_identity": {"const": "A"}}},
          "then": {
            "properties": {
              "observation_sequences": {
                "properties": {
                  "post": {
                    "properties": {
                      "10000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["B"]}}, "matched_reference": {"not": {"required": ["B"]}}}
                      },
                      "20000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["B"]}}, "matched_reference": {"not": {"required": ["B"]}}}
                      },
                      "30000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["B"]}}, "matched_reference": {"not": {"required": ["B"]}}}
                      },
                      "60000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["B"]}}, "matched_reference": {"not": {"required": ["B"]}}}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"paired_identity": {"const": "B"}}},
          "then": {
            "properties": {
              "observation_sequences": {
                "properties": {
                  "post": {
                    "properties": {
                      "10000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["A"]}}, "matched_reference": {"not": {"required": ["A"]}}}
                      },
                      "20000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["A"]}}, "matched_reference": {"not": {"required": ["A"]}}}
                      },
                      "30000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["A"]}}, "matched_reference": {"not": {"required": ["A"]}}}
                      },
                      "60000": {
                        "properties": {"frozen_plasticity": {"not": {"required": ["A"]}}, "matched_reference": {"not": {"required": ["A"]}}}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775789},
    "identifier": {"type": "string", "minLength": 1},
    "source_occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_name", "checkpoint_sha256", "origin_branch_id", "checkpoint_sequence", "sim_tick"],
      "properties": {
        "checkpoint_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.npz$"},
        "checkpoint_sha256": {"$ref": "#/$defs/digest"},
        "origin_branch_id": {"$ref": "#/$defs/identifier"},
        "checkpoint_sequence": {"$ref": "#/$defs/tick"},
        "sim_tick": {"$ref": "#/$defs/tick"}
      }
    },
    "scientific_prefix": {
      "type": "object", "additionalProperties": false,
      "required": ["event_count", "final_sequence", "final_scientific_sha256"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "final_sequence": {"$ref": "#/$defs/tick"},
        "final_scientific_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "black_input": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "input_shape", "input_dtype", "input_sha256"],
      "properties": {
        "generator": {"const": "black-rgb/v1"}, "input_dtype": {"const": "uint8"},
        "input_sha256": {"$ref": "#/$defs/digest"},
        "input_shape": {"type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [{"type": "integer", "minimum": 1, "maximum": 32},
                          {"type": "integer", "minimum": 1, "maximum": 32}, {"const": 3}]}
      }
    },
    "engine_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "model_provenance", "neural_groups", "sha256"],
      "properties": {
        "version": {"const": "fly-engine/v1"}, "sha256": {"$ref": "#/$defs/digest"},
        "model_provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["model", "model_fingerprint", "build", "eta", "parameters", "graph_ids_sha256", "graph_ptr_sha256", "graph_post_sha256", "plastic_edges_sha256", "configuration_sha256"],
          "properties": {
            "model": {"$ref": "#/$defs/identifier"}, "eta": {"type": "number"},
            "model_fingerprint": {"type": "object", "additionalProperties": false,
              "required": ["version", "sources_sha256", "sha256"],
              "properties": {"version": {"$ref": "#/$defs/identifier"}, "sha256": {"$ref": "#/$defs/digest"},
                "sources_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}}},
            "build": {"type": "object", "additionalProperties": false,
              "required": ["model", "source_sha256", "compiler", "flags", "library", "binary_sha256"],
              "properties": {"model": {"$ref": "#/$defs/identifier"}, "source_sha256": {"$ref": "#/$defs/digest"},
                "compiler": {"$ref": "#/$defs/identifier"}, "flags": {"type": "array", "items": {"type": "string"}},
                "library": {"$ref": "#/$defs/identifier"}, "binary_sha256": {"$ref": "#/$defs/digest"}}},
            "parameters": {"type": "object", "required": ["neural_dt_ms"], "properties": {"neural_dt_ms": {"const": 0.1}}},
            "configuration_sha256": {"type": "object"},
            "graph_ids_sha256": {"$ref": "#/$defs/digest"}, "graph_ptr_sha256": {"$ref": "#/$defs/digest"},
            "graph_post_sha256": {"$ref": "#/$defs/digest"}, "plastic_edges_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "neural_groups": {"type": "object", "additionalProperties": false,
          "required": ["pam11", "ppl101", "kc", "mbon07", "mbon11", "motor_left", "motor_right"],
          "properties": {
            "pam11": {"$ref": "#/$defs/neural_group"}, "ppl101": {"$ref": "#/$defs/neural_group"},
            "kc": {"$ref": "#/$defs/neural_group"}, "mbon07": {"$ref": "#/$defs/neural_group"},
            "mbon11": {"$ref": "#/$defs/neural_group"}, "motor_left": {"$ref": "#/$defs/neural_group"},
            "motor_right": {"$ref": "#/$defs/neural_group"}}}
      }
    },
    "neural_group": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tick"}},
    "fork_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "event_sequence", "event_scientific_sha256", "sim_tick"],
      "properties": {"type": {"const": "fork"}, "event_sequence": {"$ref": "#/$defs/tick"},
        "event_scientific_sha256": {"$ref": "#/$defs/digest"}, "sim_tick": {"$ref": "#/$defs/tick"}}
    },
    "thaw_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "event_sequence", "event_scientific_sha256", "sim_tick", "before_weights_frozen", "after_weights_frozen"],
      "properties": {"type": {"const": "replay_thaw"}, "event_sequence": {"$ref": "#/$defs/tick"},
        "event_scientific_sha256": {"$ref": "#/$defs/digest"}, "sim_tick": {"$ref": "#/$defs/tick"},
        "before_weights_frozen": {"type": "boolean"}, "after_weights_frozen": {"const": false}}
    },
    "call_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "event_sequence", "event_scientific_sha256", "start_tick", "end_tick", "duration_ticks", "duration_ms", "sim_ms", "stimulation", "learning", "current_mv", "pathway_detail", "qualification_detail"],
      "properties": {"type": {"const": "neutral_gap_chunk"}, "event_sequence": {"$ref": "#/$defs/tick"},
        "event_scientific_sha256": {"$ref": "#/$defs/digest"}, "start_tick": {"$ref": "#/$defs/tick"},
        "end_tick": {"$ref": "#/$defs/tick"}, "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 5000},
        "duration_ms": {"type": "number", "exclusiveMinimum": 0}, "sim_ms": {"type": "number", "minimum": 0},
        "stimulation": {"type": "null"}, "learning": {"const": false}, "current_mv": {"type": "number"},
        "pathway_detail": {"type": "boolean"}, "qualification_detail": {"type": "boolean"}}
    },
    "black_retention_recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["recipe_version", "source_occurrence", "origin_branch_id", "target_tick", "engine_identity", "run_metadata_sha256", "black_input", "scientific_prefix", "operations", "replay_recipe_sha256"],
      "properties": {
        "recipe_version": {"const": "black-retention/v1"}, "source_occurrence": {"$ref": "#/$defs/source_occurrence"},
        "origin_branch_id": {"$ref": "#/$defs/identifier"}, "target_tick": {"$ref": "#/$defs/tick"},
        "engine_identity": {"$ref": "#/$defs/engine_identity"}, "run_metadata_sha256": {"$ref": "#/$defs/digest"},
        "black_input": {"$ref": "#/$defs/black_input"}, "scientific_prefix": {"$ref": "#/$defs/scientific_prefix"},
        "operations": {"type": "array", "minItems": 1,
          "items": {"oneOf": [{"$ref": "#/$defs/fork_operation"}, {"$ref": "#/$defs/thaw_operation"}, {"$ref": "#/$defs/call_operation"}]}},
        "replay_recipe_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "state_anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_version", "anchor_id", "state_anchor_sha256", "origin_branch_id", "sim_tick", "complete_state_sha256", "durable_ancestor_checkpoint_sha256", "replay_recipe_sha256", "source_identity_sha256", "run_metadata_sha256", "source_occurrence", "scientific_prefix", "recipe"],
      "properties": {
        "anchor_version": {"const": "state-anchor/v1"}, "anchor_id": {"$ref": "#/$defs/identifier"},
        "state_anchor_sha256": {"$ref": "#/$defs/digest"}, "origin_branch_id": {"$ref": "#/$defs/identifier"},
        "sim_tick": {"$ref": "#/$defs/tick"}, "complete_state_sha256": {"$ref": "#/$defs/digest"},
        "durable_ancestor_checkpoint_sha256": {"$ref": "#/$defs/digest"}, "replay_recipe_sha256": {"$ref": "#/$defs/digest"},
        "source_identity_sha256": {"$ref": "#/$defs/digest"}, "run_metadata_sha256": {"$ref": "#/$defs/digest"},
        "source_occurrence": {"$ref": "#/$defs/source_occurrence"}, "scientific_prefix": {"$ref": "#/$defs/scientific_prefix"},
        "recipe": {"$ref": "#/$defs/black_retention_recipe"}
      }
    },
    "anchor_occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_version", "anchor_id", "state_anchor_sha256", "origin_branch_id", "sim_tick", "complete_state_sha256", "durable_ancestor_checkpoint_sha256", "replay_recipe_sha256", "source_identity_sha256", "run_metadata_sha256", "source_occurrence", "scientific_prefix", "recipe", "event_sequence"],
      "properties": {
        "anchor_version": {"$ref": "#/$defs/state_anchor/properties/anchor_version"}, "anchor_id": {"$ref": "#/$defs/identifier"},
        "state_anchor_sha256": {"$ref": "#/$defs/digest"}, "origin_branch_id": {"$ref": "#/$defs/identifier"},
        "sim_tick": {"$ref": "#/$defs/tick"}, "complete_state_sha256": {"$ref": "#/$defs/digest"},
        "durable_ancestor_checkpoint_sha256": {"$ref": "#/$defs/digest"}, "replay_recipe_sha256": {"$ref": "#/$defs/digest"},
        "source_identity_sha256": {"$ref": "#/$defs/digest"}, "run_metadata_sha256": {"$ref": "#/$defs/digest"},
        "source_occurrence": {"$ref": "#/$defs/source_occurrence"}, "scientific_prefix": {"$ref": "#/$defs/scientific_prefix"},
        "recipe": {"$ref": "#/$defs/black_retention_recipe"}, "event_sequence": {"$ref": "#/$defs/tick"}
      }
    },
    "assay_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assay_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "values", "reasons"],
      "properties": {
        "status": {"enum": ["supported", "unsupported", "inconclusive"]},
        "values": {"type": "object"},
        "reasons": {"$ref": "#/$defs/assay_reasons"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "supported"}}, "required": ["status"]},
        "then": {"properties": {"reasons": {"maxItems": 0}}},
        "else": {"properties": {"reasons": {"minItems": 1}}}
      }]
    },
    "qualification_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cs_duration_ms", "dan_onset_ms", "post_pair_gap_ms"],
